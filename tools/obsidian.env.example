# Template for ~/.config/litellm/obsidian.env (outside the repo).
#   mkdir -p ~/.config/litellm
#   cp tools/obsidian.env.example ~/.config/litellm/obsidian.env
#   chmod 600 ~/.config/litellm/obsidian.env
# Read by tools/opencode.sh; opencode.json refers to these as {env:NAME}.
# tools/check-secrets.py fails if any of these values appears in the repo.

# LiteLLM proxy base URL, including /v1, e.g. https://litellm.example.com/v1
LITELLM_BASE_URL=
# LiteLLM virtual key for this project
LITELLM_API_KEY=
